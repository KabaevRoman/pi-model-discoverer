{
  "name": "pi-model-discoverer",
  "version": "0.1.0",
  "description": "Discover models using Pi's existing /login credentials",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KabaevRoman/pi-model-discoverer.git"
  },
  "homepage": "https://github.com/KabaevRoman/pi-model-discoverer#readme",
  "bugs": "https://github.com/KabaevRoman/pi-model-discoverer/issues",
  "keywords": ["pi-package"],
  "files": ["src", "README.md"],
  "pi": { "extensions": ["./src/index.ts"] },
